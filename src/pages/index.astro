---
import Layout from '../layouts/Layout.astro'
import { AboutMe } from '../components/AboutMe'
import { TerminalHero } from '../components/TerminalHero'
import TerminalBlock from '../components/TerminalBlock.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { getFeaturedRepos, getRepoCount } from '../lib/github'
import { sponsors } from '../components/URLs'

const [featured, repoCount] = await Promise.all([
  getFeaturedRepos(6),
  getRepoCount(),
])
---
<Layout>
  <section class="hero">
    <TerminalHero client:load />
  </section>

  <section class="block reveal-on-boot">
    <TerminalBlock command="cat about.md">
      <AboutMe client:visible repoCount={repoCount} />
    </TerminalBlock>
  </section>

  {featured.length > 0 && (
    <section class="block reveal-on-boot">
      <TerminalBlock command="ls ~/projects">
        <div class="project-grid">
          {featured.map((repo) => <ProjectCard repo={repo} />)}
        </div>
        <a class="see-all" href="/projects">See all projects →</a>
      </TerminalBlock>
    </section>
  )}

  <section class="block reveal-on-boot">
    <TerminalBlock command="cat game/status">
      <p class="terminal-response">
        Currently building an indie game, solo, on nights and weekends. No
        title yet, no public build. Check back for updates.
      </p>
    </TerminalBlock>
  </section>

  <section class="block reveal-on-boot sponsor">
    <TerminalBlock command="echo $SUPPORT">
      <p class="terminal-response">
        If any of this is useful to you, sponsoring keeps it going.
      </p>
      <a class="sponsor-button" href={sponsors} target="_blank" rel="noreferrer">
        Sponsor on GitHub
      </a>
    </TerminalBlock>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 96px;
  }
  .hero :global(.hero-terminal) {
    max-width: 560px;
    margin: 0 auto;
  }
  .block {
    max-width: var(--max-width);
    margin: 0 auto 96px auto;
    padding: 0 8px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 24px;
  }
  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .sponsor-button {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--bg);
    background-color: var(--js-color);
    border-radius: 999px;
    padding: 10px 24px;
    transition: filter 0.2s var(--ease);
  }
  .sponsor-button:hover {
    filter: brightness(1.1);
  }
</style>
