---
import type { Repo } from '../lib/github'

interface Props {
  repo: Repo
}
const { repo } = Astro.props

const LANGUAGE_COLORS: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Shell: '#89e051',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Python: '#3572a5',
}
const dotColor = repo.language
  ? (LANGUAGE_COLORS[repo.language] ?? '#8a8f98')
  : null
---
<a class="card" href={repo.url} target="_blank" rel="noreferrer">
  <div class="row">
    <span class="name">{repo.name}</span>
    <span class="meta">
      {repo.language && (
        <span class="language">
          <span class="dot" style={`background-color: ${dotColor}`} />
          {repo.language}
        </span>
      )}
      <span class="stars">★ {repo.stars}</span>
    </span>
  </div>
  {repo.description && <p class="description">{repo.description}</p>}
</a>

<style>
  .card {
    display: block;
    background-color: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius);
    padding: 16px 18px;
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .card:hover {
    border-color: var(--js-color);
    transform: translateY(-2px);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-family: var(--font-mono);
  }
  .name {
    color: var(--text);
    font-weight: 600;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
    white-space: nowrap;
  }
  .language {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .stars {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .description {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 8px 0 0 0;
  }
</style>
